services:
  vikunja:
    image: "{{ vikunja_image }}"
    container_name: vikunja
    restart: unless-stopped

    environment:
      VIKUNJA_SERVICE_PUBLICURL: "{{ vikunja_public_url }}"
      VIKUNJA_SERVICE_SECRET: "{{ vikunja_service_secret }}"
      VIKUNJA_SERVICE_TIMEZONE: "{{ timezone }}"
      VIKUNJA_SERVICE_ENABLEREGISTRATION: "{{ vikunja_registration_enabled | string | lower }}"
      VIKUNJA_SERVICE_IPEXTRACTIONMETHOD: "xff"
      VIKUNJA_SERVICE_TRUSTEDPROXIES: "{{ traefik_network_subnet }}"
      VIKUNJA_DATABASE_TYPE: "postgres"
      VIKUNJA_DATABASE_HOST: "db"
      VIKUNJA_DATABASE_DATABASE: "{{ vikunja_db_name }}"
      VIKUNJA_DATABASE_USER: "{{ vikunja_db_user }}"
      VIKUNJA_DATABASE_PASSWORD: "{{ vikunja_db_password }}"

    volumes:
      - "{{ vikunja_files_dir }}:/app/vikunja/files"

    depends_on:
      db:
        condition: service_healthy

    networks:
      {{ traefik_network }}:
        ipv4_address: "{{ vikunja_ip }}"
      default:

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.vikunja.rule=Host(`{{ vikunja_host }}`)"
      - "traefik.http.routers.vikunja.entrypoints=web"
      - "traefik.http.routers.vikunja.service=vikunja"
      - "traefik.http.services.vikunja.loadbalancer.server.port=3456"
      - "traefik.docker.network={{ traefik_network }}"

  db:
    image: "{{ vikunja_postgres_image }}"
    container_name: vikunja-db
    restart: unless-stopped

    environment:
      POSTGRES_DB: "{{ vikunja_db_name }}"
      POSTGRES_USER: "{{ vikunja_db_user }}"
      POSTGRES_PASSWORD: "{{ vikunja_db_password }}"

    volumes:
      - "{{ vikunja_db_dir }}:/var/lib/postgresql"

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h localhost -U {{ vikunja_db_user }} -d {{ vikunja_db_name }}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 30s

networks:
  {{ traefik_network }}:
    external: true
