services:
  wg-easy:
    image: ghcr.io/wg-easy/wg-easy:14
    container_name: wg-easy

    environment:
      - WG_HOST={{ wg_easy_host }}
      - WG_PORT={{ wg_easy_port }}
      - WG_DEFAULT_DNS={{ wg_easy_dns }}

      # Full-Tunnel: Internet ebenfalls über WireGuard
      - WG_ALLOWED_IPS=0.0.0.0/0, ::/0

    volumes:
      - /volume1/docker/wireguard/Config:/etc/wireguard

    ports:
      - "{{ wg_easy_port }}:{{ wg_easy_port }}/udp"
      - "{{ wg_easy_web_port }}:51821/tcp"

    restart: unless-stopped

    cap_add:
      - NET_ADMIN
      - SYS_MODULE

    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1