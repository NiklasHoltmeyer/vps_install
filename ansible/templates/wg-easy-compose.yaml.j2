services:
  wg-easy:
    image: "{{ wg_easy_image }}"
    container_name: wg-easy

    environment:
      - WG_HOST={{ wg_easy_host }}
      - WG_PORT={{ wg_easy_port }}
      - WG_DEFAULT_DNS={{ wg_easy_dns }}
      - WG_ALLOWED_IPS=0.0.0.0/0, ::/0

    volumes:
      - "{{ wg_easy_config_dir }}:/etc/wireguard"
      - "/lib/modules:/lib/modules:ro"

    ports:
      - "{{ wg_easy_port }}:{{ wg_easy_port }}/udp"

    networks:
      - "{{ traefik_network }}"

    restart: unless-stopped

    cap_add:
      - NET_ADMIN
      - SYS_MODULE

    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1

    labels:
      - "traefik.enable=true"

      - "traefik.http.routers.wireguard.rule=Host(`{{ wg_easy_admin_host }}`)"
      - "traefik.http.routers.wireguard.entrypoints=web"
      - "traefik.http.routers.wireguard.service=wireguard"

      - "traefik.http.services.wireguard.loadbalancer.server.port={{ wg_easy_web_port }}"

      - "traefik.docker.network={{ traefik_network }}"

networks:
  {{ traefik_network }}:
    external: true