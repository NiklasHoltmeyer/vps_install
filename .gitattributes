# Standard: Textdateien immer mit LF
* text=auto eol=lf

# Linux / Ansible / Config
*.sh            text eol=lf
*.bash          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.j2            text eol=lf
*.ini           text eol=lf
*.cfg           text eol=lf
*.conf          text eol=lf
*.env           text eol=lf

# Dokumentation
*.md            text eol=lf
*.txt           text eol=lf

# PowerShell funktioniert ebenfalls problemlos mit LF
*.ps1           text eol=lf
*.psm1          text eol=lf

# Datenformate
*.json          text eol=lf
*.xml           text eol=lf
*.toml          text eol=lf

# Binärdateien niemals verändern
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.tar           binary
*.7z            binary
*.iso           binary
